# =============================================================================
# Badger Automation - Environment Configuration
# Copy to .env and fill in values
# =============================================================================

# --- Service A (Main API, port 8000) ---
# Service B base URL - required for status, enqueue, check-trigger
# When both services run on the SAME machine, use localhost to avoid ngrok/502 issues
SERVICE_B_BASE=http://localhost:8001
POLL_INTERVAL=15
POLL_TIMEOUT=900
POLL_REQUEST_TIMEOUT=60

# --- Service B (Drake Automation, port 8001) ---
# PostgreSQL - database owned by Service B
DATABASE_URL=postgresql://automation_user:password@localhost:5432/automation_db

# Redis - Celery broker and result backend
REDIS_URL=redis://localhost:6379/0

# Service A base URL (optional, for future callbacks)
SERVICE_A_BASE=http://localhost:8000

# --- Shared ---
# Karbon API
KARBON_ACCESS_KEY=
KARBON_BEARER_TOKEN=

# Drake application
DRAKE_EXE=
DRAKE_CWD=
DRAKE_TITLE=
USERNAME_DRAKE=
PASSWORD_DRAKE=

# Export folder for Drake client data
EXPORT_FOLDER=
